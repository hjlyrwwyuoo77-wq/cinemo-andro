
<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080B12"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- CINEMO HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:background="#111725"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CINE"
                android:textColor="#F5F7FF"
                android:textSize="25sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MO"
                android:textColor="#43D9FF"
                android:textSize="25sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:padding="10dp"
                android:background="#2458E8"
                android:text="تصدير"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"/>

        </LinearLayout>

        <!-- PROJECT BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="مشروع جديد"
                android:textColor="#F1F4FC"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="16:9  •  FHD"
                android:textColor="#8D9AB2"
                android:textSize="11sp"/>

        </LinearLayout>

        <!-- VIDEO PREVIEW -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="#03050A">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CINEMO"
                    android:textColor="#43D9FF"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.14"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="معاينة الفيديو"
                    android:textColor="#D5DCEC"
                    android:textSize="15sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="اختر مقطعًا لبدء المونتاج"
                    android:textColor="#768198"
                    android:textSize="12sp"/>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:text="PREVIEW"
                android:textColor="#43D9FF"
                android:textSize="10sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:text="● REC"
                android:textColor="#FF6378"
                android:textSize="10sp"/>

        </FrameLayout>

        <!-- PLAYBACK CONTROLS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="#111725"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#43D9FF"
                android:textSize="12sp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="|◀       ▶       ▶|"
                android:textColor="#FFFFFF"
                android:textSize="21sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#9AA7BF"
                android:textSize="12sp"/>

        </LinearLayout>

        <!-- TIMELINE TITLE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="الخط الزمني"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="＋ إضافة"
                android:textColor="#43D9FF"
                android:textSize="13sp"/>

        </LinearLayout>

        <!-- TIMELINE RULER -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:scrollbars="none"
            android:background="#0E1420">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="المسار"
                    android:textColor="#75839C"
                    android:textSize="10sp"/>

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="00:00"
                    android:textColor="#AAB5C9"
                    android:textSize="10sp"/>

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="00:05"
                    android:textColor="#AAB5C9"
                    android:textSize="10sp"/>

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="00:10"
                    android:textColor="#AAB5C9"
                    android:textSize="10sp"/>

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="00:15"
                    android:textColor="#AAB5C9"
                    android:textSize="10sp"/>

            </LinearLayout>

        </HorizontalScrollView>

        <!-- TIMELINE TRACKS -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="178dp"
            android:scrollbars="horizontal"
            android:background="#0B101A">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="6dp">

                <!-- VIDEO TRACK -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="VIDEO"
                        android:textColor="#43D9FF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="330dp"
                        android:layout_height="34dp"
                        android:gravity="center"
                        android:background="#17334A"
                        android:text="＋  إضافة فيديو"
                        android:textColor="#8CE7FF"
                        android:textSize="13sp"/>

                </LinearLayout>

                <!-- OVERLAY TRACK -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="LAYERS"
                        android:textColor="#D9A0FF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="330dp"
                        android:layout_height="34dp"
                        android:gravity="center"
                        android:background="#30203F"
                        android:text="＋  طبقة نص أو تأثير"
                        android:textColor="#E4C2FF"
                        android:textSize="13sp"/>

                </LinearLayout>

                <!-- AUDIO TRACK -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="AUDIO"
                        android:textColor="#7DE7B5"
                        android:textSize="10sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="330dp"
                        android:layout_height="34dp"
                        android:gravity="center"
                        android:background="#16382D"
                        android:text="＋  إضافة صوت أو موسيقى"
                        android:textColor="#A4F4CC"
                        android:textSize="13sp"/>

                </LinearLayout>

                <!-- COLOR TRACK -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="COLOR"
                        android:textColor="#FFC66D"
                        android:textSize="10sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="330dp"
                        android:layout_height="34dp"
                        android:gravity="center"
                        android:background="#3A2D1A"
                        android:text="＋  طبقة تصحيح الألوان"
                        android:textColor="#FFDA98"
                        android:textSize="13sp"/>

                </LinearLayout>

            </LinearLayout>

        </HorizontalScrollView>

        <!-- TOOLS TITLE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:text="أدوات الاستوديو"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <!-- TOOLS GRID -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:padding="6dp"
            android:background="#0D121E">

            <TextView
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:gravity="center"
                android:background="#17263A"
                android:text="✂\nقص وتقسيم"
                android:textColor="#64DFFF"
                android:textSize="13sp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:gravity="center"
                android:background="#25203B"
                android:text="✧\nتأثيرات"
                android:textColor="#D5ACFF"
                android:textSize="13sp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:gravity="center"
                android:background="#183329"
                android:text="◈\nالألوان"
                android:textColor="#82E8B4"
                android:textSize="13sp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:gravity="center"
                android:background="#302239"
                android:text="T\nالنصوص"
                android:textColor="#E0B8FF"
                android:textSize="13sp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:gravity="center"
                android:background="#30291C"
                android:text="♫\nالصوت"
                android:textColor="#FFD18A"
                android:textSize="13sp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:gravity="center"
                android:background="#192C43"
                android:text="⇄\nالانتقالات"
                android:textColor="#A4C8FF"
                android:textSize="13sp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:gravity="center"
                android:background="#202A3A"
                android:text="◉\nالسرعة"
                android:textColor="#C6D8F5"
                android:textSize="13sp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:gravity="center"
                android:background="#30203D"
                android:text="◇\nالطبقات"
                android:textColor="#DAB6FF"
                android:textSize="13sp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:gravity="center"
                android:background="#19342F"
                android:text="⌘\nالإعدادات"
                android:textColor="#8DE8C9"
                android:textSize="13sp"/>

        </GridLayout>

        <!-- FOOTER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="CINEMO STUDIO  •  CREATE WITHOUT LIMITS"
            android:textColor="#58677F"
            android:textSize="10sp"
            android:letterSpacing="0.08"/>

    </LinearLayout>

</ScrollView>
